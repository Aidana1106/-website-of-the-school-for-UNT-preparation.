# ENT-Bilim - Git Ignore File

# OS Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-project
*.sublime-workspace

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies
node_modules/
vendor/
bower_components/

# Build outputs
dist/
build/
*.min.css
*.min.js

# Environment variables
.env
.env.local
.env.*.local

# Temporary files
tmp/
temp/
*.tmp
*.bak
*.swp
*~

# Database
*.sql
*.sqlite
*.db

# Compiled files
*.com
*.class
*.dll
*.exe
*.o
*.so

# Archives
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip

# Images (if you want to exclude)
# Uncomment if images shouldn't be in git
# images/
# *.jpg
# *.jpeg
# *.png
# *.gif
# *.webp
# *.svg

# Testing
coverage/
.nyc_output

# Cache
.cache
.sass-cache
*.css.map
*.js.map

# System Files
*.pid
*.seed
*.pid.lock

# Optional: If using package managers
package-lock.json
yarn.lock
pnpm-lock.yaml

